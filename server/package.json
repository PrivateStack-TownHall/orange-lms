{
  "name": "orange-lms-server",
  "version": "1.0.0",
  "private": true,
  "main": "servers.js",
  "description": "Orange LMS REST API with Express, Sequelize, PostgreSQL, and Cloudinary uploads.",
  "scripts": {
    "start": "cross-env NODE_ENV=production node servers.js",
    "dev": "cross-env NODE_ENV=development nodemon servers.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "db:migrate:prod": "cross-env NODE_ENV=production sequelize-cli db:migrate"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.17.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
